# Copy to .env and fill in your own values. .env is gitignored — never commit
# it, and never paste your secret key into a chat, issue, or screenshot.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Alpaca (recommended — official API, paper trading by default)
# ---------------------------------------------------------------------------
# Find these at: Alpaca dashboard -> Manage Accounts -> your paper account.
# The Key ID is shown any time; the Secret Key is displayed ONLY ONCE when you
# generate it. If you lose it, hit "Regenerate" — you cannot look it up again.
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your-secret-key-here

# Defaults to the paper endpoint. The bot REFUSES to start against any other
# host unless HF_BOT_I_UNDERSTAND_LIVE_TRADING=true is also set, so a typo
# here cannot silently route real orders.
# A trailing "/v2" is tolerated (that's how Alpaca's dashboard displays it).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Free Alpaca accounts get the IEX feed. Set to "sip" only if you pay for the
# full consolidated tape.
# ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# Live-trading confirmation (leave unset unless you mean it)
# ---------------------------------------------------------------------------
# Required before ANY adapter will place orders with real money. Leaving this
# unset is what keeps the bot in simulation.
# HF_BOT_I_UNDERSTAND_LIVE_TRADING=true

# ---------------------------------------------------------------------------
# Robinhood (dormant — see README; Alpaca is the supported path)
# ---------------------------------------------------------------------------
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
