# Copy to .env and fill in your own values. .env is gitignored — never commit
# it, and never paste your secret key into a chat, issue, or screenshot.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Alpaca (recommended — official API, paper trading by default)
# ---------------------------------------------------------------------------
# Find these at: Alpaca dashboard -> Manage Accounts -> your paper account.
# The Key ID is shown any time; the Secret Key is displayed ONLY ONCE when you
# generate it. If you lose it, hit "Regenerate" — you cannot look it up again.
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your-secret-key-here

# Defaults to the paper endpoint. The bot REFUSES to start against any other
# host unless HF_BOT_I_UNDERSTAND_LIVE_TRADING=true is also set, so a typo
# here cannot silently route real orders.
# A trailing "/v2" is tolerated (that's how Alpaca's dashboard displays it).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Free Alpaca accounts get the IEX feed. Set to "sip" only if you pay for the
# full consolidated tape.
# ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# Live-trading confirmation (leave unset unless you mean it)
# ---------------------------------------------------------------------------
# Required before ANY adapter will place orders with real money. Leaving this
# unset is what keeps the bot in simulation.
# HF_BOT_I_UNDERSTAND_LIVE_TRADING=true

# ---------------------------------------------------------------------------
# Tiered model routing (optional — cheap models for easy work, Claude for hard)
# ---------------------------------------------------------------------------
# Lets research/study run on cheap models so your Claude budget is saved for
# the calls that actually decide capital. See `hf-bot models check`.
#
# cheap tier — NVIDIA (nemotron). Get a key at build.nvidia.com.
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
#
# mid tier — Ollama Cloud (qwen). Key from ollama.com; or point BASE_URL at a
# local Ollama (http://localhost:11434/v1) and no key is needed.
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=qwen2.5-coder

# ---------------------------------------------------------------------------
# Trade notifications (optional)
# ---------------------------------------------------------------------------
# A desktop toast fires automatically on Windows with no setup. For a phone
# notification too, point this at an incoming webhook — a Discord/Slack
# incoming webhook URL, or an ntfy.sh topic URL (https://ntfy.sh/your-topic).
# One URL works for all three; see notify.py.
# VANTRIX_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Memecoin trading (pump.fun / Solana) — OFF by default, real money, no undo.
# See README's "Memecoin trading" section before touching any of this.
# ---------------------------------------------------------------------------
# `pip install -e ".[memecoin]"` first (installs solders + base58).
#
# Use a wallet DEDICATED to this bot — never your main holdings. Phantom:
# Settings -> (new account) -> Export Private Key. This is the base58 string
# it gives you; never paste it anywhere but here.
# SOLANA_PRIVATE_KEY=
#
# Public RPC is rate-limited/unreliable; a paid one (Helius, QuickNode, etc.)
# is recommended for anything beyond occasional testing.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#
# For --memecoin-live's real-time WebSocket feed. Usually not needed — it's
# derived from SOLANA_RPC_URL by swapping https->wss. Set this explicitly
# only if your provider uses a different URL for its WebSocket endpoint.
# SOLANA_WS_URL=
#
# Hard software caps — see README for exactly what these do and don't protect.
# MEMECOIN_MAX_TRADE_USD=25
# MEMECOIN_WALLET_BUDGET_USD=50
#
# The deliberate, typo-proof opt-in. Every memecoin buy/sell refuses to run
# without this set to exactly "true" — same pattern as live equity trading.
# HF_BOT_I_UNDERSTAND_MEMECOIN_RISK=true

# ---------------------------------------------------------------------------
# Robinhood (dormant — see README; Alpaca is the supported path)
# ---------------------------------------------------------------------------
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
